# HTTPS certificate is issued automatically for the domain in .env
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	reverse_proxy app:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Temporary address used before lola-ai.uz was active: send visitors to the real domain.
89-31-29-131.sslip.io {
	redir https://lola-ai.uz{uri} permanent
}
